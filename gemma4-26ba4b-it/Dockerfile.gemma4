# Custom NeMo-RL Container Image with Native Gemma 4 Support
FROM nvcr.io/nvidia/nemo-rl:v0.6.0

USER root
WORKDIR /opt/nemo-rl

# Copy and execute Gemma 4 patches
COPY patch_gemma4.py /opt/nemo-rl/patch_gemma4.py
RUN python3 /opt/nemo-rl/patch_gemma4.py && rm -f /opt/nemo-rl/patch_gemma4.py

ENV NEMO_RL_VENV_DIR=/opt/ray_venvs
