[Unit]
Description=Unitree R1 voice & vision assistant (ASSISTANT_MODE: vad = hands-free, tap = button)
After=r1-services.service network-online.target
Requires=r1-services.service

[Service]
Type=simple
User=unitree
Environment=HOME=/home/unitree
Environment=PYTHONUNBUFFERED=1
# Default mode; override in r1-assistant.env (ASSISTANT_MODE=tap for a noisy conference booth)
Environment=ASSISTANT_MODE=vad
EnvironmentFile=-/etc/environment
# Optional overrides (WAKE_WORDS, GREETING, FOLLOW_UP_SEC, VAD_GAIN, ...), one VAR=value per line
EnvironmentFile=-/home/unitree/r1-assistant.env
WorkingDirectory=/home/unitree
# Tap mode reads the presenter clicker / USB button from /dev/input (root:input)
SupplementaryGroups=input audio
ExecStart=/usr/bin/python3 -u /home/unitree/test_vision_voice_assistant.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
