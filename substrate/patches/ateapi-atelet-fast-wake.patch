+// the store overwrites it.
+func (c *Cache) MarkFull(name string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	w, ok := c.workers[name]
+	if !ok || w.GetStatus() == nil || w.GetStatus().GetCapacity() == nil {
+		return
+	}
+	capActors := w.Status.Capacity.GetActors()
+	if capActors <= 0 {
+		capActors = 1
+	}
+	if w.Status.Allocated != nil && w.Status.Allocated.Actors >= capActors {
+		return
+	}
+	cloned := proto.Clone(w).(*ateapipb.Worker)
+	if cloned.Status.Allocated == nil {
+		cloned.Status.Allocated = &ateapipb.WorkerResources{}
+	}
+	cloned.Status.Allocated.Actors = capActors
+	c.workers[name] = cloned
